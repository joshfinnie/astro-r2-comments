---
export interface Props {
  id: string;
  class?: string;
  showForm?: boolean;
}

const { id, class: className = '', showForm = true } = Astro.props;
---

<section class={`r2-comments ${className}`} data-post-id={id}>
  <!-- Comments List -->
  <div class="r2-comments-list">
    <h3>Comments</h3>
    <div class="r2-comments-container">
      <div class="r2-comments-loading">Loading comments...</div>
      <div class="r2-comments-error" style="display: none;">Failed to load comments.</div>
      <div class="r2-comments-empty" style="display: none;">No comments yet. Be the first to comment!</div>
      <div class="r2-comments-items"></div>
    </div>
  </div>

  <!-- Comment Form -->
  {showForm && (
    <div class="r2-comment-form">
      <h3>Leave a Comment</h3>
      <form class="r2-form">
        <div class="r2-form-group">
          <label for={`author-${id}`}>Name (required)</label>
          <input
            type="text"
            id={`author-${id}`}
            name="author"
            required
            minlength="2"
            maxlength="100"
          />
        </div>

        <div class="r2-form-group">
          <label for={`email-${id}`}>Email (optional)</label>
          <input
            type="email"
            id={`email-${id}`}
            name="email"
            maxlength="100"
          />
          <small>Your email will not be published</small>
        </div>

        <div class="r2-form-group">
          <label for={`content-${id}`}>Comment (required)</label>
          <textarea
            id={`content-${id}`}
            name="content"
            required
            minlength="10"
            maxlength="5000"
            rows="5"
          ></textarea>
        </div>

        <button type="submit">Submit Comment</button>
        <div class="r2-form-message" role="status" aria-live="polite"></div>
      </form>
    </div>
  )}
</section>

<style>
  .r2-comments {
    margin: 3rem 0;
  }

  .r2-comments-list {
    margin-bottom: 3rem;
  }

  .r2-comments-list h3,
  .r2-comment-form h3 {
    margin-bottom: 1.5rem;
    font-size: 1.5rem;
    font-weight: 700;
  }

  .r2-comments-container {
    margin-top: 1rem;
  }

  .r2-comments-loading,
  .r2-comments-error,
  .r2-comments-empty {
    padding: 1.5rem;
    text-align: center;
    color: #666;
    background-color: #f9f9f9;
    border-radius: 8px;
  }

  .r2-comments-error {
    color: #721c24;
    background-color: #f8d7da;
    border: 1px solid #f5c6cb;
  }

  .r2-comment {
    padding: 1.5rem;
    margin-bottom: 1rem;
    border: 1px solid #e0e0e0;
    border-radius: 8px;
    background-color: #fafafa;
  }

  .r2-comment-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 0.75rem;
  }

  .r2-comment-author {
    font-weight: 600;
    font-size: 1rem;
    color: #333;
  }

  .r2-comment-date {
    font-size: 0.875rem;
    color: #666;
  }

  .r2-comment-content {
    color: #333;
    line-height: 1.6;
    white-space: pre-wrap;
    word-wrap: break-word;
  }

  /* Form Styles */
  .r2-comment-form {
    padding: 2rem;
    background-color: #f9f9f9;
    border-radius: 8px;
  }

  .r2-form-group {
    margin-bottom: 1.25rem;
  }

  .r2-form-group label {
    display: block;
    margin-bottom: 0.5rem;
    font-weight: 600;
    font-size: 0.95rem;
  }

  .r2-form-group input,
  .r2-form-group textarea {
    width: 100%;
    padding: 0.75rem;
    border: 1px solid #ddd;
    border-radius: 6px;
    font-family: inherit;
    font-size: 1rem;
    transition: border-color 0.2s;
  }

  .r2-form-group input:focus,
  .r2-form-group textarea:focus {
    outline: none;
    border-color: #0066cc;
  }

  .r2-form-group textarea {
    resize: vertical;
  }

  .r2-form-group small {
    display: block;
    margin-top: 0.25rem;
    font-size: 0.875rem;
    color: #666;
  }

  .r2-form button {
    padding: 0.75rem 2rem;
    background-color: #0066cc;
    color: white;
    border: none;
    border-radius: 6px;
    font-size: 1rem;
    font-weight: 600;
    cursor: pointer;
    transition: background-color 0.2s;
  }

  .r2-form button:hover {
    background-color: #0052a3;
  }

  .r2-form button:disabled {
    background-color: #ccc;
    cursor: not-allowed;
  }

  .r2-form-message {
    margin-top: 1rem;
    padding: 0.75rem;
    border-radius: 6px;
    display: none;
  }

  .r2-form-message.success {
    display: block;
    background-color: #d4edda;
    color: #155724;
    border: 1px solid #c3e6cb;
  }

  .r2-form-message.error {
    display: block;
    background-color: #f8d7da;
    color: #721c24;
    border: 1px solid #f5c6cb;
  }

  .r2-form-message.pending {
    display: block;
    background-color: #fff3cd;
    color: #856404;
    border: 1px solid #ffeaa7;
  }
</style>

<script>
  interface Comment {
    id: string;
    postId: string;
    author: string;
    content: string;
    timestamp: number;
  }

  function initializeComments() {
    const containers = document.querySelectorAll('.r2-comments');

    containers.forEach((container) => {
      const postId = container.getAttribute('data-post-id');
      if (!postId) return;

      // Initialize comment list
      const loadingEl = container.querySelector('.r2-comments-loading') as HTMLDivElement;
      const errorEl = container.querySelector('.r2-comments-error') as HTMLDivElement;
      const emptyEl = container.querySelector('.r2-comments-empty') as HTMLDivElement;
      const itemsEl = container.querySelector('.r2-comments-items') as HTMLDivElement;

      async function loadComments() {
        try {
          loadingEl.style.display = 'block';
          errorEl.style.display = 'none';
          emptyEl.style.display = 'none';
          itemsEl.innerHTML = '';

          const response = await fetch(`/api/comments/${encodeURIComponent(postId)}`);

          if (!response.ok) {
            throw new Error('Failed to fetch comments');
          }

          const data = await response.json();
          const comments: Comment[] = data.comments || [];

          loadingEl.style.display = 'none';

          if (comments.length === 0) {
            emptyEl.style.display = 'block';
            return;
          }

          itemsEl.innerHTML = comments
            .map((comment) => {
              const date = new Date(comment.timestamp);
              const formattedDate = date.toLocaleDateString('en-US', {
                year: 'numeric',
                month: 'long',
                day: 'numeric',
              });

              return `
                <div class="r2-comment" data-comment-id="${comment.id}">
                  <div class="r2-comment-header">
                    <span class="r2-comment-author">${escapeHtml(comment.author)}</span>
                    <span class="r2-comment-date">${formattedDate}</span>
                  </div>
                  <div class="r2-comment-content">${escapeHtml(comment.content)}</div>
                </div>
              `;
            })
            .join('');
        } catch (error) {
          console.error('Error loading comments:', error);
          loadingEl.style.display = 'none';
          errorEl.style.display = 'block';
        }
      }

      // Initialize form
      const form = container.querySelector('.r2-form') as HTMLFormElement;
      const messageEl = container.querySelector('.r2-form-message') as HTMLDivElement;

      if (form && messageEl) {
        form.addEventListener('submit', async (e) => {
          e.preventDefault();

          const formData = new FormData(form);
          const submitButton = form.querySelector('button[type="submit"]') as HTMLButtonElement;

          submitButton.disabled = true;
          messageEl.className = 'r2-form-message';
          messageEl.style.display = 'none';

          try {
            const response = await fetch('/api/comments/submit', {
              method: 'POST',
              headers: {
                'Content-Type': 'application/json',
              },
              body: JSON.stringify({
                postId,
                author: formData.get('author'),
                email: formData.get('email') || undefined,
                content: formData.get('content'),
              }),
            });

            const result = await response.json();

            if (response.ok) {
              if (result.comment.pending) {
                messageEl.className = 'r2-form-message pending';
                messageEl.textContent = 'Thank you! Your comment is pending approval.';
              } else {
                messageEl.className = 'r2-form-message success';
                messageEl.textContent = 'Thank you! Your comment has been posted.';
                loadComments();
              }
              form.reset();
            } else {
              throw new Error(result.error || 'Failed to submit comment');
            }
          } catch (error) {
            messageEl.className = 'r2-form-message error';
            messageEl.textContent = error instanceof Error ? error.message : 'An error occurred. Please try again.';
          } finally {
            submitButton.disabled = false;
          }
        });
      }

      // Load comments on init
      loadComments();
    });
  }

  function escapeHtml(text: string): string {
    const div = document.createElement('div');
    div.textContent = text;
    return div.innerHTML;
  }

  // Initialize on page load
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initializeComments);
  } else {
    initializeComments();
  }
</script>
